# Cabeceras para Cloudflare Pages (se ignora en otros hostings).
# Los archivos de _next/static llevan un hash en el nombre: se pueden guardar para siempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/products/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
